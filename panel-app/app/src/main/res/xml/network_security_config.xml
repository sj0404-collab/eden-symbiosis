<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Everything the panel talks to - GitHub Pages, the API and the
     ngrok tunnels - is TLS, so there is no reason to permit cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

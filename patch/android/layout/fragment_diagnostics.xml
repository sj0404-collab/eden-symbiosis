<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_diagnostics"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_diagnostics"
        style="@style/Widget.Eden.TransparentTopAppBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_diagnostics"
            style="@style/Widget.Eden.TransparentTopToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/diagnostics" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_diagnostics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/diagnostics_intro"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Result summary chips -->
            <LinearLayout
                android:id="@+id/container_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_passed"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    tools:text="6 passed" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_warned"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:clickable="false"
                    tools:text="2 warnings" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_failed"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:clickable="false"
                    tools:text="0 failed" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_run_selftest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/run_self_test"
                app:icon="@drawable/ic_verified" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_selftest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Report -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_report"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                style="?attr/materialCardViewFilledStyle"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/text_report"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="16dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textIsSelectable="true"
                    tools:text="[PASS] Driver discovery" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Technical sections -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_driver_topology"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/driver_topology"
                app:icon="@drawable/ic_tune" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_memory_state"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/memory_state"
                app:icon="@drawable/ic_memory" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_shim_report"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/symbol_borrowing"
                app:icon="@drawable/ic_speed" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_safe_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                style="?attr/materialCardViewOutlinedStyle"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/safe_mode_active"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorError" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/safe_mode_explain"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_clear_safe_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/safe_mode_reenable" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
            Launch report, reachable outside a game. The in-game button is no
            help when the game exits after two seconds: by the time the user
            wants the reason, the overlay is gone with it.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_launch_report"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/audit_title"
                app:icon="@drawable/ic_audit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_mali_report"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mali_report"
                app:icon="@drawable/ic_memory" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_driver_options"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/driver_suggestions"
                app:icon="@drawable/ic_tune" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_firmware_help"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/firmware_help"
                app:icon="@drawable/ic_key" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_layer_log"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/layer_log"
                app:icon="@drawable/ic_tune" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_clear_log"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/log_clear" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_copy_report"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/copy_report" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
